{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/hoi-vien",
      "destination": "/index.html#panel-hoivien",
      "permanent": false
    },
    {
      "source": "/hoi-vien/",
      "destination": "/index.html#panel-hoivien",
      "permanent": false
    },
    {
      "source": "/hoi-vien/index.html",
      "destination": "/index.html#panel-hoivien",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/favicon-16x16.png",
      "destination": "/favicon-16x16.png"
    },
    {
      "source": "/favicon-32x32.png",
      "destination": "/favicon-32x32.png"
    },
    {
      "source": "/favicon-512x512.png",
      "destination": "/favicon-512x512.png"
    },
    {
      "source": "/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/data/:path*",
      "destination": "/data/:path*"
    },
    {
      "source": "/index.html",
      "destination": "/index.html"
    },
    {
      "source": "/chuyen-gia/:slug",
      "destination": "/fintop_frontend/chuyen-gia/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/fintop_frontend/:path*"
    }
  ]
}
